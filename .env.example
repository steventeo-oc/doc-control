# ==============================================================================
# Document Control System — Environment Variables Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Update the values below according to your deployment environment.
# 3. Start the system:
#      docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Port Bindings
# ------------------------------------------------------------------------------
# Ports exposed on the host machine. If ports 3000, 8080, 5432, 9000 are already
# in use by other services on your server, change them here.
WEB_HOST_PORT=3000
API_HOST_PORT=8080
POSTGRES_HOST_PORT=15432
MINIO_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL) Credentials
# ------------------------------------------------------------------------------
# Change these before deploying to production!
POSTGRES_DB=doccontrol
POSTGRES_USER=doccontrol
POSTGRES_PASSWORD=changeme_postgres_secure_password

# Spring Data Source connection (matches postgres container above)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/doccontrol
SPRING_DATASOURCE_USERNAME=doccontrol
SPRING_DATASOURCE_PASSWORD=changeme_postgres_secure_password

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO S3) Credentials
# ------------------------------------------------------------------------------
# MinIO root credentials (used by the MinIO container and console)
MINIO_ROOT_USER=doccontrol
MINIO_ROOT_PASSWORD=changeme_minio_secure_password

# S3 connection for the API service
DOCCONTROL_STORAGE_ENDPOINT=http://minio:9000
DOCCONTROL_STORAGE_ACCESS_KEY=doccontrol
DOCCONTROL_STORAGE_SECRET_KEY=changeme_minio_secure_password
DOCCONTROL_STORAGE_BUCKET=doccontrol

# ------------------------------------------------------------------------------
# 4. Initial Bootstrap Administrator Account
# ------------------------------------------------------------------------------
# On first startup with an empty database, this admin account is seeded.
# IMPORTANT FOR PRODUCTION:
# When SPRING_PROFILES_ACTIVE=prod, the system will REFUSE to start if the email
# and password are left as default (admin@doccontrol.local / changeme_admin).
DOCCONTROL_BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
DOCCONTROL_BOOTSTRAP_ADMIN_PASSWORD=SetAStrongInitialPasswordHere123!
DOCCONTROL_BOOTSTRAP_ADMIN_DEPARTMENT=QA

# ------------------------------------------------------------------------------
# 5. Application URLs & CORS
# ------------------------------------------------------------------------------
# Public URL where users access the web app (used in emailed links, reset tokens)
APP_BASE_URL=http://localhost:3000
# Comma-separated list of allowed origins for CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Email Notifications (Microsoft 365 / Azure Graph API)
# ------------------------------------------------------------------------------
# Set to 'true' to enable email dispatch for approval requests, periodic reviews,
# read acknowledgments, and password reset tokens.
# When 'false', emails are logged to server console/database only without sending.
DOCCONTROL_NOTIFICATION_ENABLED=false
DOCCONTROL_NOTIFICATION_TENANT_ID=
DOCCONTROL_NOTIFICATION_CLIENT_ID=
DOCCONTROL_NOTIFICATION_CLIENT_SECRET=
DOCCONTROL_NOTIFICATION_SENDER_MAILBOX=

# ------------------------------------------------------------------------------
# 7. Microsoft Single Sign-On (SSO)
# ------------------------------------------------------------------------------
# Enables "Sign in with Microsoft 365" on the login page.
# Reuses the Azure App Registration credentials specified above.
DOCCONTROL_SSO_ENABLED=false

# ------------------------------------------------------------------------------
# 8. Document Conversion & Watermarking (Gotenberg)
# ------------------------------------------------------------------------------
# Internal URL for the Gotenberg container (LibreOffice headless PDF engine)
DOCCONTROL_WATERMARK_RENDITION_URL=http://gotenberg:3000

# ------------------------------------------------------------------------------
# 9. Spring Active Profile
# ------------------------------------------------------------------------------
# Set to 'prod' for production deployments (enforces security guards) or 'default'
SPRING_PROFILES_ACTIVE=prod
